# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/aczone_auth
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aczone_auth?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_EMAIL_VERIFICATION_EXPIRATION=24h
JWT_PASSWORD_RESET_EXPIRATION=1h

# Redis Configuration (for rate limiting and token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-myusman137@gmail.com
SMTP_PASSWORD=hvnqfgiaiamyskui
EMAIL_FROM="Tryinterview <noreply@tryinterview.site>"

# Frontend URLs
FRONTEND_URL=http://localhost:5173
VERIFY_EMAIL_URL=http://localhost:5173/verify-email
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# OAuth (Optional - for future implementation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
